# redox-os/kernel @ 719e8f5c: route all GICv3 SPIs as Group 1 NS to the BSP
#
# Target repository : https://github.com/redox-os/kernel (mirror of
#                     https://gitlab.redox-os.org/redox-os/kernel.git)
# Base commit       : 719e8f5c (master, 2026-11)
# Reason            : Pinebook Pro serial console bring-up (experiment 5).
#                     GicDistIf::init() never programmed GICD_IGROUPR or
#                     GICD_IROUTER. On this GIC-500 the UART2 SPI (100) ended
#                     up enabled, Group 1, pending at the distributor
#                     (verified by register dumps) but never delivered:
#                     with affinity routing an SPI whose IROUTER entry does
#                     not select the running CPU is held pending forever.
#                     The patch marks every SPI non-secure Group 1, routes
#                     every SPI to the boot CPU (affinity 0.0.0.0), and
#                     switches GICD_CTLR to read-modify-write so the
#                     firmware-owned mode bits (ARE and friends) are not
#                     wiped. All of this is harmless on GICv2 (IGROUPR/
#                     IROUTER RAZ/WI) and on a single-security-state GIC.
#
# Apply from src (repo root):  git apply <this file>
diff --git a/src/arch/aarch64/device/irqchip/gic.rs b/src/arch/aarch64/device/irqchip/gic.rs
index a89befc1..1b49f268 100644
--- a/src/arch/aarch64/device/irqchip/gic.rs
+++ b/src/arch/aarch64/device/irqchip/gic.rs
@@ -23,8 +23,10 @@ static GICD_ICPENDR: u32 = 0x280;
 static GICD_ICACTIVER: u32 = 0x380;
 static GICD_IPRIORITY: u32 = 0x400;
 static GICD_ITARGETSR: u32 = 0x800;
+static GICD_IGROUPR: u32 = 0x080;
 static GICD_ICFGR: u32 = 0xc00;
 static GICD_SGIR: u32 = 0xf00;
+static GICD_IROUTER: u32 = 0x6000;
 
 static GICC_EOIR: u32 = 0x0010;
 static GICC_IAR: u32 = 0x000c;
@@ -351,8 +353,32 @@ impl GicDistIf {
                 self.write(GICD_IPRIORITY + irq, 0xa0a0_a0a0);
             }
 
-            // Enable IRQ group 0 and group 1 non-secure distribution
-            self.write(GICD_CTLR, 0x3);
+            // Mark all SPIs as non-secure Group 1 interrupts. On a single
+            // security state GIC these registers are RAZ/WI, but where
+            // firmware left SPIs in Group 0 they are signalled as FIQ (to
+            // EL3, or unhandled at EL1) instead of IRQ, so no non-secure
+            // driver would ever observe them.
+            for irq in (32..self.nirqs).step_by(32) {
+                self.write(GICD_IGROUPR + ((irq / 32) * 4), 0xffff_ffff);
+            }
+
+            // Route every SPI to the boot CPU (affinity 0.0.0.0). With
+            // affinity routing (GICv3/GIC-500) an SPI whose IROUTER register
+            // points at an offline peer is never forwarded to any CPU and
+            // stays pending forever. IROUTER reads as zero on GICv2, so the
+            // loop is harmless there.
+            for irq in (32..self.nirqs).step_by(1) {
+                self.write(GICD_IROUTER + irq * 8, 0);
+            }
+
+            // Enable IRQ group 0 and group 1 non-secure distribution.
+            // Read-modify-write: GICD_CTLR holds firmware-owned mode bits
+            // (e.g. ARE for affinity routing on GICv3/GIC-500); overwriting
+            // the whole register with 0x3 dropped them and left Group 1 SPIs
+            // pending at the distributor forever.
+            let ctlr = self.read(GICD_CTLR);
+            self.write(GICD_CTLR, ctlr | 0x3);
+            info!("gic: GICD_CTLR {:#x} -> {:#x}", ctlr, ctlr | 0x3);
         }
     }
 
