+/// Session-lifecycle logging for bring-up.
+///
+/// `init` starts the desktop as `nowait VT=3 orbital …`, so stdout/stderr of
+/// orblogin and orbital go to VT3 and never reach the serial console. The
+/// kernel `debug` scheme writes straight to UART; open it once, before the
+/// first login switches namespaces, so the fd stays valid afterwards.
+static SERIAL_CONSOLE: std::sync::Mutex<Option<std::fs::File>> = std::sync::Mutex::new(None);
+
+fn serial(msg: impl AsRef<str>) {
+    use std::io::Write;
+    if let Ok(mut guard) = SERIAL_CONSOLE.lock() {
+        if let Some(file) = guard.as_mut() {
+            let _ = writeln!(file, "orblogin: {}", msg.as_ref());
+            let _ = file.flush();
+        }
+    }
+}
+
+fn open_serial_console() {
+    use std::os::unix::fs::OpenOptionsExt;
+    let file = std::fs::OpenOptions::new()
+        .write(true)
+        .custom_flags(libredox::flag::O_WRONLY | libredox::flag::O_CLOEXEC)
+        .open("/scheme/debug")
+        .ok();
+    if let Ok(mut guard) = SERIAL_CONSOLE.lock() {
+        *guard = file;
+    }
+}
+
