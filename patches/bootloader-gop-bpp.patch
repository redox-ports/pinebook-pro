+impl OsEfi {
+    /// Firmware time of day in units of 10 ms, or `None` when the platform has
+    /// no RTC (some firmware returns an error, some returns a constant).
+    fn time_10ms(&self) -> Option<u64> {
+        let mut time = Time::default();
+        let mut capabilities = TimeCapabilities::default();
+        match (self.st.RuntimeServices.GetTime)(&mut time, &mut capabilities) {
+            Status::SUCCESS => Some(
+                u64::from(time.Day) * 8_640_000
+                    + u64::from(time.Hour) * 360_000
+                    + u64::from(time.Minute) * 6_000
+                    + u64::from(time.Second) * 100
+                    + u64::from(time.Nanosecond / 10_000_000),
+            ),
+            _ => None,
+        }
+    }
+}
