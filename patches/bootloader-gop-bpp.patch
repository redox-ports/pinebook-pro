+                    // The firmware may hand out a surface that is not 32 bits per
+                    // pixel (U-Boot programs RGB565 for the RK3399 eDP panel), so
+                    // the size and the reported format must follow the real mode.
+                    // Consumers treat 0 (unknown) as 32 bits per pixel.
+                    let bpp = match mode.bpp {
+                        16 | 32 => mode.bpp,
+                        _ => 32,
+                    };
                     let virt = unsafe {
                         paging_framebuffer(
                             os,
                             page_phys,
                             mode.base,
-                            (mode.stride * mode.height * 4) as u64,
+                            (mode.stride * mode.height * (bpp / 8)) as u64,
                         )
                     }
                     .expect("Failed to map framebuffer");
@@ -678,6 +686,7 @@ fn main(os: &impl Os) -> (usize, u64, KernelArgs) {
