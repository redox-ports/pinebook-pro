+// TEMPORARY bring-up instrumentation: emit one byte on the RK3399 debug UART
+// (UART2 @ 0xff1a0000, identity-mapped here) without EFI or the console.
+// Also disables loopback mode in case it was left enabled.
+unsafe fn raw_marker(byte: u8) {
+    unsafe {
+        let base = 0xff1a_0000usize;
+        core::ptr::write_volatile((base + 0x10) as *mut u32, 0x03); // MCR: DTR|RTS, loopback off
+        for _ in 0..100_000 {
+            if core::ptr::read_volatile((base + 0x14) as *const u32) & (1 << 5) != 0 {
+                break; // THR empty
+            }
+        }
+        core::ptr::write_volatile(base as *mut u32, u32::from(byte));
+    }
+}
