+/// TEMPORARY bring-up instrumentation (experiment 5): print the UART and
+/// GIC distributor state relevant to the RK3399 serial interrupt.
+const DEBUG_UART: usize = 0xFFFF_8000_FF1A_0000;
+const DEBUG_GICD: usize = 0xFFFF_8000_FEE0_0000;
+const DEBUG_GICR: usize = 0xFFFF_8000_FEF0_0000;
+
+static COM1_IRQ_FIRES: AtomicU32 = AtomicU32::new(0);
+
+unsafe fn debug_read(addr: usize) -> u32 {
+    unsafe { (addr as *const u32).read_volatile() }
+}
+
+unsafe fn debug_dump_state(tag: &str) {
+    unsafe {
+        info!(
+            "debug: {} uart ier={:#x} iir={:#x} mcr={:#x} lsr={:#x} msr={:#x}",
+            tag,
+            debug_read(DEBUG_UART + 0x04),
+            debug_read(DEBUG_UART + 0x08),
+            debug_read(DEBUG_UART + 0x10),
+            debug_read(DEBUG_UART + 0x14),
+            debug_read(DEBUG_UART + 0x18),
+        );
+        // hwirq 132 (SPI 100): igroupr word 4, isenabler word 4, ispender word
+        // 4, icfgr register 8 (irqs 128..143); irouter132 for affinity
+        // routing; GICR_WAKER of the boot CPU redistributor.
+        info!(
+            "debug: {} gicd ctlr={:#x} typer={:#x} igroupr4={:#x} isenabler4={:#x} ispender4={:#x} icfgr8={:#x} irouter132={:#x} gicr_waker={:#x}",
+            tag,
+            debug_read(DEBUG_GICD + 0x0000),
+            debug_read(DEBUG_GICD + 0x0004),
+            debug_read(DEBUG_GICD + 0x0090),
+            debug_read(DEBUG_GICD + 0x0110),
+            debug_read(DEBUG_GICD + 0x0210),
+            debug_read(DEBUG_GICD + 0x0C20),
+            debug_read(DEBUG_GICD + 0x6100 + 132 * 8),
+            debug_read(DEBUG_GICR + 0x0014),
+        );
+    }
+}
+
+static DEBUG_TICKS: AtomicU32 = AtomicU32::new(0);
+
+/// TEMPORARY: called from the timer interrupt; every ~2 s print the UART
+/// state, so received bytes are visible even when no receive interrupt fires.
+pub(crate) fn debug_tick() {
+    let ticks = DEBUG_TICKS.fetch_add(1, Ordering::Relaxed);
+    if ticks % 200 == 1 {
+        unsafe { debug_dump_state("tick") }
+    }
+}
+
