+        if fires < 3 {
+            unsafe { debug_dump_state("irq") }
+        }
         COM1.lock().receive(token);
         unsafe {
             // FIXME add_irq accepts a u8 as irq number
@@ -59,6 +116,7 @@ pub unsafe fn init(fdt: &Fdt<'_>) {
         register_irq(virq as u32, Box::new(Com1Irq {}));
         COM1.lock().enable_irq();
