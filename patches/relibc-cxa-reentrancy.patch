# redox-os/relibc @ b83feabc: fix re-entrant atexit/thread-atexit finalization
#
# Target repository : https://github.com/redox-os/relibc (mirror of
#                     https://gitlab.redox-os.org/redox-os/relibc.git)
# Base commit       : b83feabc (master, 2026-11)
# Reason            : every uutils binary panicked at exit on the Pinebook Pro
#                     (experiment 10):
#
#                         RELIBC PANIC: panicked at src/cxa.rs:84:11:
#                         RefCell already borrowed
#
#                     `__cxa_thread_finalize()` held `DTORS.borrow_mut()`
#                     across the destructor calls. A destructor that registers
#                     another thread-atexit handler re-enters
#                     `__cxa_thread_atexit_impl()`, whose `DTORS.borrow_mut()`
#                     (line 84) then panics, `relibc_panic` aborts with
#                     `brk #1`, and the process loses any buffered stdout -
#                     which is why `rm`/`mkdir` printed the panic while `ls`
#                     appeared to die with no output at all.
#
#                     `__cxa_finalize()` had the same class of bug with its
#                     spin mutex: it called destructors while holding the lock,
#                     so a destructor registering an atexit handler (or a
#                     second thread finalizing) would deadlock.
#
#                     A first attempt - pop one entry under a scoped borrow and
#                     run it after the borrow is released - was NOT enough on
#                     hardware: the panic moved from src/cxa.rs:84 to the same
#                     `DTORS.borrow_mut()` in `__cxa_thread_atexit_impl` but
#                     was still hit, because the borrow flag is set for the
#                     whole borrow_mut/push/drop sequence, and a registration
#                     that lands inside it (from a nested finalize, or from a
#                     signal handler that the userspace signal trampoline runs
#                     in the middle of the drain - this kernel delivers signals
#                     from timer ticks and syscall epilogues) trips the flag.
#
#                     Final fix: the thread-atexit stack is an intrusive list
#                     behind a `Cell<*mut ThreadAtExitNode>`. Registering only
#                     allocates and links a node, so it can never observe the
#                     state of a drain in progress, and `__cxa_thread_finalize`
#                     detaches the whole stack before walking it, looping until
#                     no new nodes appear (LIFO order preserved; handlers
#                     registered by destructors run in the next pass).
#                     `__cxa_finalize()` additionally collects the atexit
#                     entries under its lock, drops the lock, then calls them.
#
# Apply from src (repo root):  git apply <this file>
diff --git a/src/cxa.rs b/src/cxa.rs
index c1d77247..eb5bcd81 100644
--- a/src/cxa.rs
+++ b/src/cxa.rs
@@ -1,6 +1,6 @@
 use crate::platform::types::{c_int, c_void};
-use alloc::vec::Vec;
-use core::cell::RefCell;
+use alloc::{boxed::Box, vec::Vec};
+use core::{cell::Cell, ptr};
 use spin::Mutex;
 
 #[derive(Clone, Copy)]
@@ -10,16 +10,27 @@ struct CxaAtExitFunc {
     dso: usize,
 }
 
-#[derive(Clone, Copy)]
-struct CxaThreadAtExitFunc {
+/// Entry of the thread-atexit handler stack.
+///
+/// `__cxa_thread_atexit_impl` may be called at any time, including from a
+/// destructor that `__cxa_thread_finalize` is already running and from a signal
+/// handler that the userspace signal trampoline invoked in the middle of the
+/// drain. An intrusive list behind a `Cell` therefore replaces the former
+/// `RefCell<Vec<...>>`: registering only pushes a node and never observes (or
+/// conflicts with) the state of the list being walked, whereas any borrow flag
+/// turned those re-entrant registrations into
+/// `panicked at src/cxa.rs: ...: RefCell already borrowed` -> `abort()` ->
+/// `brk #1`, losing the process's buffered stdout (measured on the Pinebook
+/// Pro for every uutils applet: `ls`, `pwd`, `rm`, `mkdir`, `head`).
+struct ThreadAtExitNode {
     func: extern "C" fn(*mut c_void),
     obj: *mut c_void,
-    dso: *mut c_void,
+    next: *mut ThreadAtExitNode,
 }
 
 static CXA_ATEXIT_FUNCS: Mutex<Vec<Option<CxaAtExitFunc>>> = Mutex::new(Vec::new());
 #[thread_local]
-static DTORS: RefCell<Vec<CxaThreadAtExitFunc>> = RefCell::new(Vec::new());
+static DTORS: Cell<*mut ThreadAtExitNode> = Cell::new(ptr::null_mut());
 
 #[unsafe(no_mangle)]
 pub unsafe extern "C" fn __cxa_atexit(
@@ -53,24 +64,33 @@ pub unsafe extern "C" fn __cxa_atexit(
 
 #[unsafe(no_mangle)]
 pub unsafe extern "C" fn __cxa_finalize(dso: *mut c_void) {
-    let mut funcs = CXA_ATEXIT_FUNCS.lock();
-
-    let dso_usize = dso as usize;
+    // Destructors are arbitrary code and may register new atexit handlers.
+    // Collect what has to run under the lock, drop the lock, then run it:
+    // calling them while holding the spin mutex would deadlock instead.
+    let mut to_run: Vec<CxaAtExitFunc> = Vec::new();
+    {
+        let mut funcs = CXA_ATEXIT_FUNCS.lock();
+        let dso_usize = dso as usize;
+
+        for slot in funcs.iter_mut().rev() {
+            if let Some(entry) = slot.as_ref()
+                && (dso.is_null() || entry.dso == dso_usize)
+            {
+                to_run.push(*entry);
+                *slot = None;
+            }
+        }
 
-    for slot in funcs.iter_mut().rev() {
-        if let Some(entry) = slot.as_ref()
-            && (dso.is_null() || entry.dso == dso_usize)
-            && let Some(entry_to_run) = slot.take()
-        {
-            (entry_to_run.func)(entry_to_run.arg as *mut c_void);
+        // clean up remaining list
+        if dso.is_null() {
+            funcs.clear();
+        } else {
+            funcs.retain(Option::is_some);
         }
     }
 
-    // clean up remaining list
-    if dso.is_null() {
-        funcs.clear();
-    } else {
-        funcs.retain(Option::is_some);
+    for entry in to_run {
+        (entry.func)(entry.arg as *mut c_void);
     }
 }
 
@@ -80,15 +100,32 @@ pub unsafe extern "C" fn __cxa_thread_atexit_impl(
     obj: *mut c_void,
     dso: *mut c_void,
 ) {
-    let entry = CxaThreadAtExitFunc { func, obj, dso };
-    DTORS.borrow_mut().push(entry);
+    let _ = dso;
+    let node = Box::into_raw(Box::new(ThreadAtExitNode {
+        func,
+        obj,
+        next: DTORS.get(),
+    }));
+    DTORS.set(node);
 }
 
 // called internally
 pub unsafe fn __cxa_thread_finalize() {
-    let mut dtors = DTORS.borrow_mut();
-    while let Some(entry) = dtors.pop() {
-        (entry.func)(entry.obj);
+    loop {
+        // Detach the whole stack first. Handlers registered from here on (by a
+        // destructor, or by a signal handler interrupting this drain) start a
+        // fresh stack, which the next iteration of this loop picks up, so
+        // registration never touches the list currently being walked.
+        let mut node = DTORS.replace(ptr::null_mut());
+        if node.is_null() {
+            break;
+        }
+
+        while !node.is_null() {
+            let current = unsafe { Box::from_raw(node) };
+            node = current.next;
+            (current.func)(current.obj);
+        }
     }
 }
 
