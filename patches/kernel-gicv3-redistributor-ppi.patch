# redox-os/kernel @ 719e8f5c: program the GICv3 redistributor (PPIs/SGIs)
#
# Target repository : https://github.com/redox-os/kernel (mirror of
#                     https://gitlab.redox-os.org/redox-os/kernel.git)
# Base commit       : 719e8f5c (master, 2026-11)
# Reason            : the architected timer never fired on the Pinebook Pro, so
#                     nothing preempted, `nanosleep` never returned, scheme
#                     timeouts never expired and the VT only repainted when a
#                     key produced a syscall ("you have to press Enter",
#                     experiment 11). Two independent defects in the GICv3
#                     driver:
#
#                     (1) `GicV3::parse()` built a fresh `reg()` iterator for
#                     every entry, so `chunk.iter().next()` returned the *GICD*
#                     chunk `#redistributor-regions` times. The boot log showed
#                     it plainly: `gicrs: [(FEE00000, 10000)]` - that is the
#                     distributor, not the redistributor region the RK3399 DT
#                     places at `fef00000` (six 0x20000 frames). The frames
#                     were also stored without `PHYS_OFFSET`, unlike the GICD.
#
#                     (2) The redistributor itself was never programmed. In
#                     GICv3 SGIs (0..16) and PPIs (16..32) are banked per CPU:
#                     their enable, group, priority and trigger configuration
#                     live in `GICR_ISENABLER0`, `GICR_IGROUPR0`,
#                     `GICR_IPRIORITYR` and `GICR_ICFGR1` of the redistributor's
#                     SGI frame, and the frame has to be woken through
#                     `GICR_WAKER`. `GICD_ISENABLER` only covers SPIs (ID 32+),
#                     so `IRQ_CHIP.irq_enable(27)` for the timer PPI wrote a
#                     RES0 bit and disabled nothing while enabling nothing.
#                     The host SPI work (UART2) was unaffected, which is why
#                     interrupts looked healthy.
#
#                     Fix: keep one iterator so the redistributor region is
#                     parsed (and translate it like the GICD), compute the
#                     current CPU's frame from the region size and the CPU
#                     count the distributor reports, wake it through GICR_WAKER
#                     (best effort: QEMU and the GIC-500 can leave undefined
#                     bits set) and set group 1 NS + priority 0xa0 +
#                     level-triggered PPIs, then route `irq_enable`/
#                     `irq_disable` for IDs below 32 to
#                     `GICR_ISENABLER0`/`GICR_ICENABLER0`.
#
#                     Verified in QEMU (`-M virt,gic-version=3`): `sleep(10ms)`
#                     and `sleep(250ms)` now return after 10.9 ms and 250.2 ms;
#                     before the fix a 10 ms `nanosleep` never returned.
#
# Apply from src (repo root):  git apply <this file>
diff --git a/src/arch/aarch64/device/irqchip/gicv3.rs b/src/arch/aarch64/device/irqchip/gicv3.rs
index fb435b8e..dfb886a4 100644
--- a/src/arch/aarch64/device/irqchip/gicv3.rs
+++ b/src/arch/aarch64/device/irqchip/gicv3.rs
@@ -23,6 +23,32 @@ pub struct GicV3 {
     pub irq_range: (usize, usize),
 }
 
+// Redistributor register offsets. Each redistributor owns two 64 KiB frames:
+// the RD frame (control/TYPER/WAKER) and the SGI frame, where the banked SGIs
+// (0..16) and PPIs (16..32) are configured. GICD only covers SPIs, so writing
+// GICD_ISENABLER for a PPI is a write to a RES0 bit: on this port that silently
+// disabled every private interrupt, including the architected timer PPI (27)
+// that drives `context::switch::tick()` and thus `nanosleep` (experiment 11).
+const GICR_WAKER: u32 = 0x0014;
+const GICR_WAKER_PROCESSOR_SLEEP: u32 = 1 << 0;
+const GICR_WAKER_CHILDREN_ASLEEP: u32 = 1 << 1;
+const GICR_SGI_FRAME: usize = 0x1_0000;
+const GICR_IGROUPR0: u32 = 0x0080;
+const GICR_ISENABLER0: u32 = 0x0100;
+const GICR_ICENABLER0: u32 = 0x0180;
+const GICR_IPRIORITYR: u32 = 0x0400;
+const GICR_ICFGR1: u32 = 0x0c04;
+/// Frame stride used when the devicetree does not describe the region size.
+const GICR_FRAME_STRIDE: usize = 0x2_0000;
+
+fn gicr_read32(base: usize, offset: u32) -> u32 {
+    unsafe { core::ptr::read_volatile((base + offset as usize) as *const u32) }
+}
+
+fn gicr_write32(base: usize, offset: u32, value: u32) {
+    unsafe { core::ptr::write_volatile((base + offset as usize) as *mut u32, value) }
+}
+
