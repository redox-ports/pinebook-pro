+
+    /// Redistributor frame belonging to the running CPU.
+    ///
+    /// A single `#redistributor-regions` entry describes all per-CPU frames
+    /// back to back, so the stride is the region size divided by the number of
+    /// CPUs the distributor reports.
+    fn current_cpu_gicr(&self) -> Option<usize> {
+        let (region_base, region_len) = *self.gicrs.first()?;
+        let ncpus = core::cmp::max(self.gic_dist_if.ncpus as usize, 1);
+        let stride = match region_len / ncpus {
+            0 => GICR_FRAME_STRIDE,
+            stride => stride & !0xfff,
+        };
+        Some(region_base + usize::try_from(crate::cpu_id().get()).ok()? * stride)
+    }
+
+    /// Wake the local redistributor and reset the banked SGI/PPI state.
+    unsafe fn init_current_cpu_redist(&mut self) -> Result<()> {
+        let rd = self.current_cpu_gicr().ok_or_else(|| Error::new(EINVAL))?;
+
+        // Clearing ProcessorSleep powers the frame up; ChildrenAsleep drops
+        // once the redistributor has finished its internal wake-up. Both QEMU
+        // and the GIC-500 can leave bits outside the defined fields set, so
+        // the wait is best-effort: what actually matters is that the
+        // GICR_ISENABLER0 write below takes effect.
+        let waker_before = gicr_read32(rd, GICR_WAKER);
+        gicr_write32(rd, GICR_WAKER, waker_before & !GICR_WAKER_PROCESSOR_SLEEP);
+        let mut spins = 0u32;
+        while gicr_read32(rd, GICR_WAKER) & GICR_WAKER_CHILDREN_ASLEEP != 0 {
+            spins += 1;
+            if spins >= 100_000 {
+                debug!(
+                    "gicv3: redistributor {:#x} still reports ChildrenAsleep ({:#x})",
+                    rd,
+                    gicr_read32(rd, GICR_WAKER)
+                );
+                break;
+            }
+            core::hint::spin_loop();
+        }
+
+        let sgi = rd + GICR_SGI_FRAME;
+
+        // SGIs and PPIs are private, so their group, priority and trigger
+        // configuration live here rather than in the distributor. Group 1 NS
+        // matches the SPI setup, and PPIs (the architected timer among them)
+        // are level-triggered (GICR_ICFGR1 bit 2n == 0).
+        gicr_write32(sgi, GICR_IGROUPR0, 0xffff_ffff);
+        for irq in (0..32).step_by(4) {
+            gicr_write32(sgi, GICR_IPRIORITYR + 4 * irq, 0xa0a0_a0a0);
+        }
+        gicr_write32(sgi, GICR_ICFGR1, 0);
+
+        info!(
+            "gicv3: redistributor {:#x} ready, GICR_WAKER {:#x} -> {:#x}",
+            rd,
+            waker_before,
+            gicr_read32(rd, GICR_WAKER)
+        );
+        Ok(())
+    }
 }
 
