+    fn get_key_timeout(&self, milliseconds: u32) -> OsKey {
+        // `ReadKeyStroke` is non-blocking, so poll it. The `uefi` crate only
+        // exposes `SetTimer` with an unusable signature, and a timer event
+        // would need it, so the deadline comes from the firmware RTC.
+        //
+        // Boot services are still active here, so `GetTime` may be called.
+        // Some boards have no working RTC in firmware (Pinebook Pro: U-Boot
+        // has no driver for the RK808 RTC), and a constant "clock" would
+        // turn this loop into a hang. Probe whether the value actually
+        // advances before trusting it.
+        let clock_start = self.time_10ms();
+        let clock_ticks = match clock_start {
+            Some(start) => {
+                for _ in 0..20_000 {
+                    core::hint::spin_loop();
+                }
+                matches!(self.time_10ms(), Some(now) if now > start)
+            }
+            None => false,
+        };
+
+        let mut key = TextInputKey {
+            ScanCode: 0,
+            UnicodeChar: 0,
+        };
+        let mut spins = 0u32;
+        loop {
+            match (self.st.ConsoleIn.ReadKeyStroke)(self.st.ConsoleIn, &mut key) {
+                Status::SUCCESS => return map_key(&key),
+                Status::NOT_READY => (),
+                // A broken console must not hang the boot.
+                _ => return OsKey::Timeout,
+            }
+
+            if clock_ticks {
+                match (clock_start, self.time_10ms()) {
+                    (Some(start), Some(now)) => {
+                        if now.saturating_sub(start) >= u64::from(milliseconds) / 10 {
+                            return OsKey::Timeout;
+                        }
+                    }
+                    // The clock disappeared after the probe: stop waiting.
+                    _ => return OsKey::Timeout,
+                }
+            } else {
+                // No usable clock: wait for a bounded number of iterations
+                // (roughly a fraction of a second) and then boot.
+                spins += 1;
+                if spins > 400_000 {
+                    return OsKey::Timeout;
+                }
+            }
+
+            for _ in 0..2_000 {
+                core::hint::spin_loop();
+            }
         }
     }
 
