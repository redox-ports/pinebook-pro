+/// 10 ms ticks from the aarch64 architected counter.
+///
+/// `CNTPCT_EL0` is guaranteed readable at EL2 and above; at EL1 the access is
+/// controlled by `CNTHCTL_EL2`, so there the firmware clock is used instead.
+/// The counter does not depend on an RTC driver, which is exactly what the
+/// Pinebook Pro firmware lacks (no RK808 RTC in U-Boot), so the boot menu can
+/// honour its timeout there.
+#[cfg(target_arch = "aarch64")]
+fn arch_counter_us() -> Option<u64> {
+    let current_el: u64;
+    let frequency: u64;
+    let counter: u64;
+    unsafe {
+        core::arch::asm!("mrs {}, CurrentEL", out(reg) current_el, options(nomem, nostack));
+        if (current_el >> 2) & 3 < 2 {
+            return None;
+        }
+        core::arch::asm!("mrs {}, CNTFRQ_EL0", out(reg) frequency, options(nomem, nostack));
+        core::arch::asm!("mrs {}, CNTPCT_EL0", out(reg) counter, options(nomem, nostack));
+    }
+    if frequency == 0 {
+        return None;
+    }
+    Some(counter.checked_mul(1_000_000)? / frequency)
+}
+
+impl OsEfi {
+    /// Monotonic time in microseconds, or `None` when the platform has no usable
+    /// clock.
+    ///
+    /// Microseconds rather than the 10 ms units of the firmware clock: the
+    /// caller probes whether the value advances by spinning for a very short
+    /// time, and a coarser unit would make the probe look like a dead clock.
+    /// The architected counter is preferred on aarch64; the firmware RTC is the
+    /// fallback (and is the only option on other architectures).
+    fn time_us(&self) -> Option<u64> {
+        #[cfg(target_arch = "aarch64")]
+        {
+            if let Some(ticks) = arch_counter_us() {
+                return Some(ticks);
+            }
+        }
+
+        let mut time = Time::default();
+        let mut capabilities = TimeCapabilities::default();
+        match (self.st.RuntimeServices.GetTime)(&mut time, &mut capabilities) {
+            Status::SUCCESS => Some(
+                (u64::from(time.Day) * 8_640_000
+                    + u64::from(time.Hour) * 360_000
+                    + u64::from(time.Minute) * 6_000
+                    + u64::from(time.Second) * 100
+                    + u64::from(time.Nanosecond / 10_000_000))
+                    * 10_000,
+            ),
+            _ => None,
+        }
+    }
+}
