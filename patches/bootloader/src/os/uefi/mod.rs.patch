+/// Translate a firmware key stroke into the bootloader's key enum.
+fn map_key(key: &TextInputKey) -> OsKey {
+    match key.ScanCode {
+        0 => match key.UnicodeChar {
+            8 => OsKey::Backspace,
+            13 => OsKey::Enter,
+            w => match char::from_u32(w as u32) {
+                Some(c) => OsKey::Char(c),
+                None => OsKey::Other,
+            },
+        },
+        1 => OsKey::Up,
+        2 => OsKey::Down,
+        3 => OsKey::Right,
+        4 => OsKey::Left,
+        8 => OsKey::Delete,
+        _ => OsKey::Other,
+    }
+}
+
+/// Bits per pixel of the linear framebuffer described by a GOP mode info.
+///
+/// UEFI only guarantees the byte layout for the two 8-bit-per-channel formats;
+/// anything else (notably the RGB565 surface U-Boot programs for eDP panels)
+/// is described by bit masks, so derive the pixel width from them. Returns 0
+/// when the mode has no linear framebuffer or the width cannot be derived.
+fn pixel_bits_per_pixel(info: &GraphicsOutputModeInfo) -> u32 {
+    match info.PixelFormat {
+        GraphicsPixelFormat::PixelRedGreenBlueReserved8BitPerColor
+        | GraphicsPixelFormat::PixelBlueGreenRedReserved8BitPerColor => 32,
+        GraphicsPixelFormat::PixelBitMask => {
+            let masks = &info.PixelInformation;
+            let used = masks.RedMask | masks.GreenMask | masks.BlueMask;
+            if used == 0 {
+                0
+            } else {
+                32 - used.leading_zeros()
+            }
+        }
+        _ => 0,
+    }
+}
