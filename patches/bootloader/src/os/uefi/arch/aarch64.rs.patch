+/// Make freshly written code visible to instruction fetch.
+///
+/// The kernel image is copied into memory with normal stores, i.e. through the
+/// data cache, and instruction fetch is not coherent with it on ARM. Without
+/// the sequence below a jump into freshly loaded code can execute stale or
+/// partially written bytes; whether it bites depends on which physical pages
+/// the firmware handed out, so the symptom is layout-dependent and QEMU (which
+/// does not model caches) never shows it.
+unsafe fn cache_sync_instructions(base: u64, size: u64) {
+    unsafe {
+        let ctr: u64;
+        asm!("mrs {}, ctr_el0", out(reg) ctr, options(nostack));
+        // DminLine is log2 of the number of 4-byte words in a cache line.
+        let dline = 4u64 << ((ctr >> 16) & 0xf);
+
+        let mut addr = base & !(dline - 1);
+        let end = base.saturating_add(size);
+        while addr < end {
+            // Clean to the point of coherency and drop the line, so the next
+            // read comes from memory.
+            asm!("dc civac, {}", in(reg) addr, options(nostack));
+            addr += dline;
+        }
+
+        asm!("dsb sy", "ic iallu", "dsb sy", "isb", options(nostack),);
+    }
+}
+
+/// Read the RK3399 debug UART2 state that the kernel inherits and log it.
+///
+/// The reads themselves are what matters on this board: with them the kernel
+/// starts reliably, without them every image since the initfs grew to 24 MiB
+/// hangs before its first instruction (experiment 12). The port is healthy at
+/// this point (`ier=0 lcr=3 mcr=3 lsr=0x60`), so the reads change nothing in
+/// the UART - the mechanism is not understood, only that these four loads at
+/// 0xff1a0004/0x0c/0x10/0x14 make the difference between a booting and a dead
+/// kernel. U-Boot's own console driver reads LSR only and does not substitute.
+fn dump_uart2(tag: &str) {
+    unsafe {
+        let base = 0xff1a_0000usize;
+        let rd = |off: usize| core::ptr::read_volatile((base + off) as *const u32);
+        println!(
+            "uart2 {}: ier={:#x} lcr={:#x} mcr={:#x} lsr={:#x}",
+            tag,
+            rd(0x04),
+            rd(0x0c),
+            rd(0x10),
+            rd(0x14),
+        );
+    }
+}
+
