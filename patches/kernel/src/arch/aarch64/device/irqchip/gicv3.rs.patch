+    fn send_sgi_to_mpidr(&mut self, sgi: u8, mpidr: u64) -> Result<()> {
+        if sgi >= 16 {
+            return Err(Error::new(EINVAL));
+        }
+        let aff0 = mpidr & 0xff;
+        // The target list is a 16-bit bitmap of Aff0 values.
+        if aff0 >= 16 {
+            return Err(Error::new(EINVAL));
+        }
+        let aff1 = (mpidr >> 8) & 0xff;
+        let aff2 = (mpidr >> 16) & 0xff;
+        let aff3 = (mpidr >> 32) & 0xff;
+        // ICC_SGI1R_EL1: [15:0] TargetList, [23:16] Aff1, [27:24] INTID,
+        // [39:32] Aff2, [47:40] IRM, [55:48] Aff3.
+        let value = (1u64 << aff0)
+            | (aff1 << 16)
+            | (u64::from(sgi) << 24)
+            | (aff2 << 32)
+            | (aff3 << 48);
+        unsafe {
+            asm!("dsb ishst", options(nostack, preserves_flags));
+            asm!("msr icc_sgi1r_el1, {}", in(reg) value);
+            asm!("isb", options(nostack, preserves_flags));
+        }
+        Ok(())
+    }
+
+    fn send_sgi_all_but_self(&mut self, sgi: u8) -> Result<()> {
+        if sgi >= 16 {
+            return Err(Error::new(EINVAL));
+        }
+        // IRM = 1: every PE except the requesting one.
+        let value = (1u64 << 40) | (u64::from(sgi) << 24);
+        unsafe {
+            asm!("dsb ishst", options(nostack, preserves_flags));
+            asm!("msr icc_sgi1r_el1, {}", in(reg) value);
+            asm!("isb", options(nostack, preserves_flags));
+        }
+        Ok(())
+    }
+
+    fn smp_cpu_capacity(&self) -> Option<usize> {
+        // One 128 KiB redistributor pair per CPU. The DT region is the
+        // authoritative source for GICv3 (GICD CPUNumber is not).
+        let (_, region_len) = *self.gicrs.first()?;
+        let capacity = region_len / GICR_FRAME_STRIDE;
+        (capacity > 0).then_some(capacity)
+    }
 }
 
