+// Redistributor register offsets. Each redistributor owns two 64 KiB frames:
+// the RD frame (control/TYPER/WAKER) and the SGI frame, where the banked SGIs
+// (0..16) and PPIs (16..32) are configured. GICD only covers SPIs, so writing
+// GICD_ISENABLER for a PPI is a write to a RES0 bit: on this port that silently
+// disabled every private interrupt, including the architected timer PPI (27)
+// that drives `context::switch::tick()` and thus `nanosleep` (experiment 11).
+const GICR_WAKER: u32 = 0x0014;
+const GICR_WAKER_PROCESSOR_SLEEP: u32 = 1 << 0;
+const GICR_WAKER_CHILDREN_ASLEEP: u32 = 1 << 1;
+const GICR_SGI_FRAME: usize = 0x1_0000;
+const GICR_IGROUPR0: u32 = 0x0080;
+const GICR_ISENABLER0: u32 = 0x0100;
+const GICR_ICENABLER0: u32 = 0x0180;
+const GICR_IPRIORITYR: u32 = 0x0400;
+const GICR_ICFGR1: u32 = 0x0c04;
+/// Frame stride used when the devicetree does not describe the region size.
+const GICR_FRAME_STRIDE: usize = 0x2_0000;
+
+fn gicr_read32(base: usize, offset: u32) -> u32 {
+    unsafe { core::ptr::read_volatile((base + offset as usize) as *const u32) }
+}
+
+fn gicr_write32(base: usize, offset: u32, value: u32) {
+    unsafe { core::ptr::write_volatile((base + offset as usize) as *mut u32, value) }
+}
