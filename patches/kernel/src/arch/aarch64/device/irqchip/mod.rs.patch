+/// Run a closure with the root interrupt controller.
+fn with_root_ic<R>(f: impl FnOnce(&mut dyn InterruptController) -> R) -> Option<R> {
+    let idx = super::ROOT_IC_IDX.load(core::sync::atomic::Ordering::Acquire);
+    unsafe {
+        let chips = &mut IRQ_CHIP.irq_chip_list.chips;
+        let chip = chips.get_mut(idx)?;
+        Some(f(&mut *chip.ic))
+    }
+}
