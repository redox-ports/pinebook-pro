diff --git a/src/devices/uart_16550.rs b/src/devices/uart_16550.rs
index cc0a26c1..e034c2d3 100644
--- a/src/devices/uart_16550.rs
+++ b/src/devices/uart_16550.rs
@@ -102,8 +102,12 @@ where
             // Use 8 data bits, no parity, one stop bit
             self.line_ctrl.write(0x03.into());
 
-            // Enable and clear FIFOs with 14-byte threshold
-            self.fifo_ctrl.write(0xC7.into());
+            // Enable and clear FIFOs with a one-character receive threshold.
+            // A larger threshold delays the receive interrupt until the FIFO
+            // fills up; UARTs without a functioning character-timeout
+            // interrupt (e.g. RK3399 snps,dw-apb-uart) then never interrupt
+            // for interactive input, one keystroke at a time.
+            self.fifo_ctrl.write(0x07.into());
 
             // IRQs enabled, RTS/DSR set
             self.modem_ctrl.write(0x0B.into());
@@ -111,6 +115,7 @@ where
             // Enable loopback
             self.modem_ctrl.write(0x1E.into());
             // Perform loopback test with even/odd pattern
+            let mut loopback_ok = true;
             for &byte in &[0x55, 0xAA] {
                 // Write loopback byte
                 self.data.write(byte.into());
@@ -125,19 +130,32 @@ where
                 // Read loopback byte
                 let loopback = self.data.read();
                 if loopback != byte.into() {
-                    return Err(());
+                    loopback_ok = false;
                 }
             }
 
-            // Enable DTR, RTS, OUT1, and OUT2, disable loopback
+            // Enable DTR, RTS, OUT1, and OUT2, disable loopback. Restore the
+            // modem/interrupt registers even when the self-test failed:
+            // bailing out early left the port with loopback enabled and the
+            // receive interrupt disabled, silencing both output and input.
             self.modem_ctrl.write(0x0F.into());
             // Enable receive interrupt
             self.int_en.write(0x01.into());
+
+            if !loopback_ok {
+                info!("uart: loopback self-test failed; loopback disabled, receive irq enabled");
+                return Err(());
+            }
         }
 
         Ok(())
     }
 
+    /// Enable the received-data-available interrupt.
+    pub fn enable_irq(&mut self) {
+        self.int_en.write(0x01.into());
+    }
