 unsafe impl Send for Display {}
 
+impl Display {
+    #[inline]
+    fn bytes_per_pixel(&self) -> usize {
+        self.bpp / 8
+    }
+
+    /// Convert a 0xAARRGGBB value to the hardware pixel format.
+    #[inline]
+    fn pixel(&self, color: u32) -> u32 {
+        if self.bpp == 16 {
+            // RGB565, as programmed by firmware for eDP panels (U-Boot
+            // rk_vop.c forces VIDEO_BPP16 for VOP_MODE_EDP).
+            ((color >> 8) & 0xF800) | ((color >> 5) & 0x07E0) | ((color >> 3) & 0x001F)
+        } else {
+            color
+        }
+    }
+
+    /// Write one pixel at (x, y), where y is already within the display.
+    unsafe fn set_pixel(&self, x: usize, y: usize, color: u32) {
+        let ptr = unsafe {
+            self.onscreen_ptr
+                .add((y * self.stride + x) * self.bytes_per_pixel())
+        };
+        if self.bpp == 16 {
+            unsafe { ptr::write_unaligned(ptr.cast::<u16>(), color as u16) };
+        } else {
+            unsafe { ptr::write_unaligned(ptr.cast::<u32>(), color) };
+        }
+    }
+
+    /// Zero a single text row (up to 16 pixels high, clamped to the display).
+    unsafe fn clear_text_row(&self, y: usize) {
+        let first = y * 16;
+        if first >= self.height {
+            return;
+        }
+        let rows = (self.height - first).min(16);
+        let bytes = rows * self.stride * self.bytes_per_pixel();
+        let ptr = unsafe {
+            self.onscreen_ptr
+                .add(first * self.stride * self.bytes_per_pixel())
+        };
+        unsafe { ptr::write_bytes(ptr, 0, bytes) };
+    }
+}
