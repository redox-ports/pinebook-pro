+fn inherited_interrupt_parent<'a>(fdt: &Fdt<'a>, node: FdtNode<'a>) -> Option<FdtNode<'a>> {
+    // The DT spec makes `interrupt-parent` inheritable. Walk up until a node
+    // declares it, then resolve the phandle to the interrupt controller.
+    // (The fdt crate stops at the immediate parent instead of following the
+    // inherited controller, which breaks nodes like /timer on RK3399 where
+    // only the root node carries `interrupt-parent = <&gic>`.)
+    let mut current = Some(node);
+    while let Some(node) = current {
+        if let Some(raw) = node.raw_property("interrupt-parent") {
+            let phandle = raw.as_value::<u32>().ok()?;
+            return fdt.root().resolve_phandle(PHandle::new(phandle));
+        }
+        current = node.parent();
+    }
+    None
+}
+
+#[cfg(dtb)]
+pub fn get_interrupt<'a>(fdt: &Fdt<'a>, node: &FdtNode<'a>, idx: usize) -> Option<IrqCell> {
+    // `interrupts-extended` carries a parent phandle per entry, so the fdt
+    // crate can parse it without resolving an inherited parent.
+    if node.raw_property("interrupts-extended").is_some() {
+        let interrupts = node.property::<Interrupts>()?;
+        return match interrupts {
+            Interrupts::Extended(interrupts) => interrupts.iter().nth(idx).and_then(|interrupt| {
+                IrqCell::from_interrupt_specifier(interrupt.interrupt_specifier())
+            }),
+            Interrupts::Legacy(_) => None,
+        };
+    }
+
+    // Legacy `interrupts`: resolve the inherited parent ourselves so that the
+    // specifier width comes from the real controller's #interrupt-cells.
+    let raw = node.raw_property("interrupts")?;
+    let parent = inherited_interrupt_parent(fdt, *node)?;
+    let interrupt_cells = parent.property::<InterruptCells>()?.0;
+    if !(1..=4).contains(&interrupt_cells) {
+        return None;
+    }
+
+    let stride = interrupt_cells * 4;
+    let start = idx.checked_mul(stride)?;
+    let chunk = raw
+        .value
+        .get(start..start.checked_add(stride)?)?;
+    let word = |i: usize| -> Option<u32> {
+        Some(u32::from_be_bytes(
+            chunk.get(i * 4..i * 4 + 4)?.try_into().ok()?,
+        ))
+    };
+
+    match interrupt_cells {
+        1 => Some(IrqCell::L1(word(0)?)),
+        2 => Some(IrqCell::L2(word(0)?, word(1)?)),
+        // GICv3 has a fourth PPI-partition cell; ignored for now.
+        3 | 4 => Some(IrqCell::L3(word(0)?, word(1)?, word(2)?)),
+        _ => None,
     }
 }
 
